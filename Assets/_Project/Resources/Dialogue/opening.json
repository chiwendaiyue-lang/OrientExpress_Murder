      "node": {
        "nodeType": "dialogue",
        "speakerCharacterId": "ratchett",
        "speakerName": "雷切特",
        "text": "波洛先生，我是个有钱人──一个非常有钱的人。处在这种地位的人总是有敌人的。我也有一个敌人。",
        "stage": {
          "focusCharacterId": "ratchett",
          "slots": [
            {
              "slotId": "left",
              "characterId": "poirot",
              "portrait": "poirot_normal"
