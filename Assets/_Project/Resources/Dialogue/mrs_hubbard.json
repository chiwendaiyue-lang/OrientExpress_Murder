    {
      "id": "notice_hubbard_latch_success",
      "node": {
        "nodeType": "dialogue",
        "speakerCharacterId": "system",
        "speakerName": "系统",
        "text": "门闩在门把手上方。即使提包挂在门把手上，也不可能挡住门闩。哈伯德太太的说法和房间结构不符。",
        "nextNodeId": "node28",
        "rewards": {
